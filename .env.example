# ---- Neon PostgreSQL ----
# Chuỗi pooled (pgbouncer) — dùng cho app runtime. Lấy từ Neon dashboard > Connection Details > "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/vlxd?sslmode=require&pgbouncer=true&connection_limit=5"
# Chuỗi direct (không pooler) — dùng cho `prisma migrate`. Lấy từ "Direct connection".
DIRECT_URL="postgresql://neondb_owner:npg_WhV71udaJsEm@ep-floral-poetry-ay8a9md5-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---- App ----
PORT=3000
NODE_ENV=development
# Danh sách origin cho CORS, phân tách bằng dấu phẩy (Web Admin + Expo dev)
CORS_ORIGINS="http://localhost:3001,http://localhost:8081"

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET="doi-chuoi-nay-thanh-secret-ngau-nhien-dai"
JWT_REFRESH_SECRET="doi-chuoi-nay-thanh-secret-khac-ngau-nhien-dai"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---- Seed (tài khoản chủ cửa hàng đầu tiên) ----
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="Owner@123"
